{
  "name": "pod-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/download/*", "/media/*.mp4"] },
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "pod-downloads" }],
  "ratelimits": [{ "name": "DOWNLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],
  "routes": [{ "pattern": "pod.sushilbang.com", "custom_domain": true }]
}
